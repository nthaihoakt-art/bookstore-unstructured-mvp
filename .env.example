# Local/deploy environment variables
NODE_ENV=production
PORT=4000

# Required in production. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB Atlas (NoSQL #1 - Document Database)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bookstore_migrated?appName=Cluster0

# Redis (NoSQL #2 - Key-Value Store)
# Chạy local: docker run -d --name bookstore-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://127.0.0.1:6379
# Redis Cloud (nếu deploy):
# REDIS_URL=redis://:<password>@<host>:<port>
